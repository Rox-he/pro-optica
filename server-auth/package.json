{
  "name": "optica-auth-api",
  "version": "2.0.0",
  "description": "API de autenticación y roles para Óptica Convicción (MySQL)",
  "main": "index.js",
  "scripts": {
    "seed": "node seed.js",
    "start": "node index.js",
    "test:unit": "node --test --test-reporter=spec tests/unit/validaciones.test.js tests/unit/auth.middleware.test.js tests/unit/promociones.test.js",
    "test:integration": "node --test --test-reporter=spec tests/integration/auth.api.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "migrate:pedidos": "node migrate-pedidos.js",
    "migrate:promociones": "node migrate-promociones.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
